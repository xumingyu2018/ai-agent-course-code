# Langfuse（必填）— 在 https://cloud.langfuse.com 或自建实例创建
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# OpenAI 兼容 API（必填）
OPENAI_API_KEY=
# 可选：自定义兼容端点（如 Azure / 国内网关 / 本地代理）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称
OPENAI_MODEL=qwen-plus

# 短生命周期脚本建议关闭 LangChain 后台 callback，确保 flush 前写完
LANGCHAIN_CALLBACKS_BACKGROUND=false

# 评测 Dataset 名称（可选，默认 deepagents-eval）
# LANGFUSE_DATASET_NAME=deepagents-eval
